# Получить на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_PHONE=+79001234567

# StringSession — если задана, SMS-код при запуске не нужен
SESSION_STRING=

# Токен от @BotFather
BOT_TOKEN=

# Ключ OpenAI
OPENAI_API_KEY=

# Тег на который ВСЕГДА отвечать (с собакой)
TARGET_TAG=@Kairachat_bot

# Вероятность ответа на случайный пост (0.0 - 1.0)
RESPONSE_PROBABILITY=0.30

# Минимальная пауза между ответами в одном канале (минуты)
COOLDOWN_MINUTES=45

# Часы активности (по МСК). 25 = до 01:00 ночи
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=25

# Твой Telegram user_id (для доступа к admin bot)
ADMIN_USER_ID=
